# ---------------------------------------------------------------
# Data files over GitHub's 100 MB per-file limit (free accounts).
# .gitignore can't filter by size, so list each large file here.
# Find new ones with:  find . -type f -size +100M -not -path './.git/*'
# ---------------------------------------------------------------
/起诉书.csv
/indictment.csv
indictment*.csv

# ---------------------------------------------------------------
# Derived data. All derived products live in ~/indictment_work/
# (outside Dropbox and git). Nothing below should ever be committed.
# Exception: small hand-built reference tables in ref/ ARE tracked.
# ---------------------------------------------------------------
*.parquet
*.parquet/
*.duckdb
*.duckdb.wal
*.arrow
*.feather
/sensitive*
/gold/
/models/

# ---------------------------------------------------------------
# Third-party source files that must not be redistributed from a
# public repository (copyrighted standard, unlicensed compilations).
# See ref/sources/user_supplied/README.md for how to obtain them.
# ---------------------------------------------------------------
ref/sources/user_supplied/*.pdf
ref/sources/user_supplied/*.xlsx

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Dropbox
.dropbox
.dropbox.attr
.dropbox.cache/
*conflicted copy*

# ---------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.env
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# R
# ---------------------------------------------------------------
.Rhistory
.RData
.Rapp.history
.Rproj.user/
.Renviron

# ---------------------------------------------------------------
# Databases, logs, temp files
# ---------------------------------------------------------------
*.log
*.tmp
*.temp
*.sqlite-journal
*.db-journal
~$*
